generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  owner       String
  repoUrl     String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}